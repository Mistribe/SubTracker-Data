{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "key": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$",
                "maxLength": 64,
                "description": "A unique identifier for the label (uniqueness is checked by .scripts/validate.py)."
            },
            "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50,
                "description": "The display name of the label."
            },
            "color": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$",
                "description": "The colour of the label as a CSS hex colour (#RRGGBB)."
            }
        },
        "required": [
            "key",
            "name",
            "color"
        ],
        "additionalProperties": false
    }
}
